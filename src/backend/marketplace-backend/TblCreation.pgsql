-- 1) Полноценная очистка для пересоздания
DROP TABLE IF EXISTS product;

-- 2) Создание таблицы 'product' + автоинкрементным 'id'
CREATE TABLE product (
    id INT PRIMARY KEY, -- Использование BIGSERIAL для автоинкрементного ID
    articl VARCHAR(50) UNIQUE NOT NULL, -- уникальное и обязательное
    title VARCHAR(255) NOT NULL,
    cover VARCHAR(500),
    short_info VARCHAR(500),
    description TEXT,
    price DECIMAL(10,2) NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 0,
    product_type VARCHAR(50) NOT NULL
);

-- 3) Заполнение тестовыми данными
